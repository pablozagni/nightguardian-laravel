{
    "name": "nightguardian/laravel",
    "description": "Laravel SDK for NightGuardian: self-hosted error and health monitoring that never slows down or breaks your app.",
    "keywords": [
        "laravel",
        "monitoring",
        "error-tracking",
        "exceptions",
        "nightguardian"
    ],
    "license": "MIT",
    "homepage": "https://github.com/pablozagni/nightguardian-laravel",
    "type": "library",
    "require": {
        "php": "^7.1.3|^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-zlib": "*",
        "illuminate/cache": "^5.8|^6.0|^7.0|^8.0",
        "illuminate/console": "^5.8|^6.0|^7.0|^8.0",
        "illuminate/contracts": "^5.8|^6.0|^7.0|^8.0",
        "illuminate/http": "^5.8|^6.0|^7.0|^8.0",
        "illuminate/log": "^5.8|^6.0|^7.0|^8.0",
        "illuminate/queue": "^5.8|^6.0|^7.0|^8.0",
        "illuminate/routing": "^5.8|^6.0|^7.0|^8.0",
        "illuminate/support": "^5.8|^6.0|^7.0|^8.0",
        "illuminate/view": "^5.8|^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "laravel/framework": "8.*",
        "laravel/pint": "^1.13",
        "opis/json-schema": "^2.3",
        "orchestra/testbench": "^6.0",
        "pestphp/pest": "^1.0",
        "pestphp/pest-plugin-laravel": "^1.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "NightGuardian\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NightGuardian\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NightGuardian\\Laravel\\NightGuardianServiceProvider"
            ],
            "aliases": {
                "NightGuardian": "NightGuardian\\Laravel\\Facades\\NightGuardian"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "lint:fix": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
