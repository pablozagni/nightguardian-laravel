<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="NightGuardian">
            <directory suffix="Test.php">./tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- The suite configures the SDK itself and never reaches a real collector (see tests/NoRealNetworkTest.php). -->
        <env name="NIGHTGUARDIAN_ENABLED" value="true" force="true"/>
    </php>
</phpunit>
