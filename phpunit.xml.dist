<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="NightGuardian">
            <directory suffix="Test.php">./tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- The suite must not depend on the developer's shell: it configures the SDK itself. -->
        <env name="NIGHTGUARDIAN_ENABLED" value="true" force="true"/>
        <env name="NIGHTGUARDIAN_URL" value="" force="true"/>
        <env name="NIGHTGUARDIAN_TOKEN" value="" force="true"/>
    </php>
</phpunit>
